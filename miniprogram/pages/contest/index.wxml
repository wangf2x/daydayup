<view class="page">
  <view class="head">
    <view class="head-row">
      <view>
        <view class="head-title">挑战赛</view>
        <view class="head-sub">选一场赛事，答完自动判分</view>
      </view>
      <view class="settings-btn" bindtap="goSettings">设置</view>
    </view>
    <view class="settings-summary">{{settingsSummary}}</view>
  </view>

  <view class="contest-list">
    <view
      wx:for="{{contests}}"
      wx:key="id"
      class="contest"
      data-id="{{item.id}}"
      bindtap="onStart"
    >
      <view class="contest-emoji" style="background: {{item.color}}1a">{{item.emoji}}</view>
      <view class="contest-body">
        <view class="contest-title">{{item.title}}</view>
        <view class="contest-sub">{{item.subtitle}} · 题库 {{item.bankSize}} 题 / 抽 {{item.size}} 题</view>
        <view class="contest-meta">
          <text wx:if="{{item.plays > 0}}">最高 {{item.best}} 分 · 已挑战 {{item.plays}} 次</text>
          <text wx:else>还没挑战过</text>
        </view>
      </view>
      <view class="contest-go" style="background: {{item.color}}">开始</view>
    </view>
  </view>

  <view class="tip">题目来自内置 3-4 年级题库，答完立即给出对错和答案。</view>
</view>
