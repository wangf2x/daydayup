.page {
  min-height: 100vh;
  padding: 32rpx 30rpx 60rpx;
  box-sizing: border-box;
  background: #f2f5fa;
  color: #1d2330;
}

.head-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #24406e;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8d99ad;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.subject-card {
  width: 48.5%;
  margin-bottom: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.07);
}

.subject-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.subject-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.subject-count {
  font-size: 34rpx;
  font-weight: 800;
  color: #24406e;
}

.subject-name {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.subject-meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #99a4b6;
}

.progress {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
}

.subject-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #8d99ad;
}

.subject-go {
  color: #3b6bff;
  font-weight: 600;
}

.empty {
  margin-top: 10rpx;
  padding: 60rpx 40rpx;
  border-radius: 26rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.07);
}

.empty-emoji {
  font-size: 68rpx;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d99ad;
}

.empty-btn {
  margin-top: 28rpx;
  border-radius: 18rpx;
}
