.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 160rpx;
  box-sizing: border-box;
  background: #f2f5fa;
  color: #1d2330;
}

.hero {
  padding: 32rpx;
  border-radius: 28rpx;
  color: #fff;
  box-shadow: 0 16rpx 34rpx rgba(36, 64, 110, 0.24);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  opacity: 0.88;
}

.tabs {
  display: flex;
  margin-top: 26rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #e8edf6;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5a6779;
}

.tab--active {
  background: #fff;
  color: #24406e;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(29, 35, 48, 0.08);
}

.menu-bar {
  margin-top: 24rpx;
  white-space: nowrap;
}

.menu {
  display: inline-flex;
  align-items: center;
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #e8edf6;
  font-size: 25rpx;
  color: #5a6779;
}

.menu--active {
  background: #24406e;
  color: #fff;
  font-weight: 700;
}

.menu-count {
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  font-size: 20rpx;
}

.menu:not(.menu--active) .menu-count {
  background: rgba(36, 64, 110, 0.1);
  color: #44536b;
}

.filters {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(29, 35, 48, 0.06);
}

.filters-title {
  font-size: 23rpx;
  color: #5a6779;
  font-weight: 600;
}

.filters-sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #a4afc0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.chip {
  display: flex;
  align-items: center;
  margin: 0 14rpx 12rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe3f0;
  background: #eef2f9;
  font-size: 22rpx;
  color: #44536b;
}

.chip--off {
  background: #fff;
  color: #a4afc0;
  border-color: #e3e8f0;
  text-decoration: line-through;
}

.chip-symbol {
  margin-right: 8rpx;
  font-weight: 700;
}

.chip--reset {
  background: #fff;
  border-color: #24406e;
  color: #24406e;
}

.marks {
  display: flex;
  align-items: center;
}

.mark {
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #3b6bff;
  font-size: 21rpx;
  font-weight: 700;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.kp {
  margin: 0 10rpx 8rpx 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #7b8798;
  font-size: 20rpx;
}

.card-list {
  margin-top: 24rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.07);
}

.card--done {
  background: #fbfcfe;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3e0;
  color: #b06a00;
  font-size: 21rpx;
}

.status--done {
  background: #e8f7ee;
  color: #14804a;
}

.card-date {
  font-size: 21rpx;
  color: #a4afc0;
}

.card-stem {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.62;
  color: #2a3142;
}

.empty {
  margin-top: 24rpx;
  padding: 56rpx 40rpx;
  border-radius: 26rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.07);
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d99ad;
}

.empty-btn {
  margin-top: 26rpx;
  border-radius: 18rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -8rpx 24rpx rgba(29, 35, 48, 0.08);
}

.bar-btn {
  flex: 1;
  margin: 0 10rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.bar-btn--primary {
  background: #24406e;
  color: #fff;
}

.challenge-card {
  margin-top: 24rpx;
  padding: 48rpx 36rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.07);
}

.challenge-emoji {
  font-size: 78rpx;
}

.challenge-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #24406e;
}

.challenge-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8798;
}

.challenge-meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a4afc0;
}

.challenge-link {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #8d99ad;
}

.challenge-btn {
  margin-top: 32rpx;
  border-radius: 18rpx;
}
